// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER") // "ADMIN" or "USER"
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  favorites     Favorite[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  name_en   String?
  name_az   String?
  slug      String    @unique
  image     String?
  products  Product[]
  stories   Story[]
  attributes Attribute[]
  packaging Packaging[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Attribute {
  id          String   @id @default(cuid())
  name        String   // e.g. "Размер", "Упаковка"
  name_en     String?
  name_az     String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options     AttributeOption[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttributeOption {
  id          String   @id @default(cuid())
  name        String   // e.g. "S", "M", "L" or "Стандарт", "Премиум"
  name_en     String?
  name_az     String?
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  name_en     String?
  name_az     String?
  slug        String   @unique
  description String?
  description_en String?
  description_az String?
  price       Decimal
  oldPrice    Decimal?
  images      String   // Stored as JSON string of URLs
  recipients  String   @default("[]") // Stored as JSON string of Recipient[]
  occasions   String   @default("[]") // Stored as JSON string of Occasion[]
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  isPopular   Boolean  @default(false)
  isTrending  Boolean  @default(false)
  inStock     Boolean  @default(true)
  
  // New field for storing selected attributes and their price adjustments
  // JSON structure: { "AttributeID": { "OptionID": priceAdjustment, ... }, ... }
  productOptions String @default("{}") 

  orderItems  OrderItem[]
  favorites   Favorite[]
  reviews     Review[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      @default(5)
  text        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Story {
  id        String    @id @default(cuid())
  title     String?
  title_en  String?
  title_az  String?
  description String?
  description_en String?
  description_az String?
  mediaUrl  String
  type      String   @default("image") // "image" or "video"
  isActive  Boolean  @default(true)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  status    String      @default("PENDING") // PENDING, PAID, DELIVERED, CANCELLED
  total     Decimal
  items     OrderItem[]
  
  // Contact Info
  email     String
  phone     String
  name      String

  // Address
  address   String
  city      String      @default("Baku")
  comment   String?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  // Addons
  packagingId String?
  packaging   Packaging? @relation(fields: [packagingId], references: [id])
  cardText    String?
  cardRecipient String? // e.g. "mom", "wife"
}

model Packaging {
  id          String   @id @default(cuid())
  name        String
  name_en     String?
  name_az     String?
  price       Decimal
  image       String?
  isAvailable Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CardTemplate {
  id        String   @id @default(cuid())
  text      String
  text_en   String?
  text_az   String?
  recipient String   // e.g. "mom", "wife"
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal
  options   String  @default("{}") // Store selected options as JSON string
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Home", "Office"
  address   String
  city      String
  phone     String?
  createdAt DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model GlobalSettings {
  id              String   @id @default("singleton")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model SliderItem {
  id          String   @id @default(cuid())
  title       String
  title_en    String?
  title_az    String?
  subtitle    String?
  subtitle_en String?
  subtitle_az String?
  description String?
  description_en String?
  description_az String?
  imageUrl    String
  buttonText  String   @default("Смотреть каталог")
  buttonText_en String?
  buttonText_az String?
  buttonLink  String   @default("/#catalog")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
