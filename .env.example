# PostgreSQL database URL for production/deploy
DATABASE_URL=postgresql://username:password@host:5432/database

# NextAuth configuration
NEXTAUTH_URL=https://your-railway-app-url.app
NEXTAUTH_SECRET=your_random_secret

# AWS S3 credentials (if used)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=us-east-1

# Optional public envs
NEXT_PUBLIC_WHATSAPP_PHONE=1234567890
MAINTENANCE_PASSWORD=Allium1380
